# Template for your local settings. Copy it once:
#   cp .env.example .env.local
# .env.local is git-ignored. This file is committed: names and comments only, never a value.
# Every person uses their OWN development application — see docs/development.md.

# Discord Developer Portal → your application → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord Developer Portal → your application → Bot → Reset Token. Secret: server side only.
DISCORD_BOT_TOKEN=

# Your test server: Discord → Settings → Advanced → Developer Mode, then right-click the server → Copy Server ID
DISCORD_GUILD_ID=

# Database. Locally a SQLite file (relative to the project root); in production the Turso URL (libsql://…).
DATABASE_URL=file:./data/reports.db
# Only for Turso. Empty for a local file.
DATABASE_AUTH_TOKEN=

# Secret Vercel Cron sends as "Authorization: Bearer …" when it calls the reminder endpoint. Any long random string.
CRON_SECRET=
